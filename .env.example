# ============================================================
#  Copiez ce fichier en ".env" puis remplissez les valeurs.
#  ⚠️ Ne partagez JAMAIS le fichier .env (il contient vos clés secrètes).
# ============================================================

# --- Claude (https://console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modèle Claude (facultatif)
CLAUDE_MODEL=claude-opus-5-5

# --- WhatsApp (https://developers.facebook.com → votre app → WhatsApp → API Setup) ---
# Le jeton d'accès (Access token)
WHATSAPP_TOKEN=EAAG...
# L'identifiant de votre numéro (Phone number ID) — ce n'est PAS le numéro lui-même
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Un mot de passe que VOUS inventez, à recopier dans Meta lors de la config du webhook
WHATSAPP_VERIFY_TOKEN=choisissez-un-mot-secret
# Le "App Secret" (Paramètres de l'app → Général). Recommandé pour la sécurité.
WHATSAPP_APP_SECRET=

# Port du serveur (facultatif)
PORT=3000
